# Copy to ~/.config/project-luna/luna-agent/providers.env and keep that file out of Git.
# Empty/unset providers are skipped automatically.
LUNA_AGENT_BACKEND=free
LUNA_AGENT_ENABLE_LOCAL_FREE=1
OLLAMA_HOST=http://127.0.0.1:11434
LUNA_AGENT_LOCAL_MODEL=ornith-1.5:9b

# Independent cloud pools.
INCEPTION_API_KEY=
GEMINI_API_KEY=
OPENCODE_ZEN_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
# Mistral Free mode uses whatever current Labs/Free model is available to the account.
LUNA_AGENT_MISTRAL_MODEL=

# Optional experimental provider. Keep disabled until its current API contract is verified.
ATRIA_API_KEY=
ATRIA_BASE_URL=
ATRIA_MODEL=

# Optional pool order override, using provider IDs from free_backend.py.
# LUNA_AGENT_FREE_POOL=inception,gemini,opencode-zen,cerebras,openrouter,mistral,atria,ollama
