From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Project Luna <luna@localhost>
Date: Wed, 9 Sep 2026 08:30:00 +0700
Subject: [PATCH] x86: add initial Luna boot handoff parser

Add the first kernel-side slice of the Luna boot contract. The parser walks
Linux setup_data, identifies the Luna setup node, validates the fixed v1
header and record framing, and exposes the physical address of the required
LUNA_INIT_IMAGE record to later init code.

This patch deliberately does not execute the image and does not implement
BLAKE3 verification yet. It is structural plumbing only.

The patch targets the Linux 7.2.y stable tree used by Project Luna.

---
 arch/x86/kernel/Makefile    |   1 +
 arch/x86/kernel/luna_boot.c | 198 ++++++++++++++++++++++++++++++++++++++++++++
 arch/x86/kernel/setup.c     |   1 +
 include/linux/luna_boot.h    |  25 ++++++
 4 files changed, 225 insertions(+)
 create mode 100644 arch/x86/kernel/luna_boot.c
 create mode 100644 include/linux/luna_boot.h

diff --git a/arch/x86/kernel/Makefile b/arch/x86/kernel/Makefile
--- a/arch/x86/kernel/Makefile
+++ b/arch/x86/kernel/Makefile
@@ -89,0 +90 @@
+obj-y			+= luna_boot.o

diff --git a/arch/x86/kernel/luna_boot.c b/arch/x86/kernel/luna_boot.c
new file mode 100644
--- /dev/null
+++ b/arch/x86/kernel/luna_boot.c
@@ -0,0 +1,198 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/luna_boot.h>
+#include <linux/types.h>
+
+#include <asm/bootparam.h>
+#include <asm/setup.h>
+
+#define LUNA_SETUP_DATA_TYPE		0x4c554e41U
+#define LUNA_HANDOFF_MAGIC		0x31304448_414e554cULL
+#define LUNA_HANDOFF_MAJOR		1U
+#define LUNA_HANDOFF_HEADER_SIZE	84U
+#define LUNA_HANDOFF_MAX_SIZE		(64U * 1024U)
+#define LUNA_RECORD_LUNA_INIT_IMAGE	5U
+
+struct luna_handoff_header {
+	u64 magic;
+	u16 major;
+	u16 minor;
+	u32 header_size;
+	u32 total_size;
+	u32 flags;
+	u32 reserved;
+	u64 attempt_id;
+	u64 records_offset;
+	u64 records_size;
+	u8 checksum[32];
+} __packed;
+
+struct luna_handoff_record {
+	u16 type;
+	u16 flags;
+	u32 size;
+	u8 payload[];
+} __packed;
+
+struct luna_init_image_record {
+	u64 address;
+	u64 size;
+	u8 digest[32];
+	u32 reserved0;
+	u32 reserved1;
+} __packed;
+
+static phys_addr_t luna_handoff_phys __initdata;
+static u32 luna_handoff_size __initdata;
+static phys_addr_t luna_init_phys __initdata;
+static u64 luna_init_size __initdata;
+static bool luna_handoff_present __initdata;
+static bool luna_init_present __initdata;
+
+static bool luna_range_ok(u64 offset, u64 size, u64 total)
+{
+	if (offset > total)
+		return false;
+	if (size > total - offset)
+		return false;
+	return true;
+}
+
+static void __init luna_parse_handoff(phys_addr_t phys, u32 len)
+{
+	struct luna_handoff_header *hdr;
+	struct luna_handoff_record *record;
+	u8 *base;
+	u64 offset;
+	u64 records_end;
+
+	if (len < sizeof(*hdr) || len > LUNA_HANDOFF_MAX_SIZE)
+		return;
+
+	base = early_memremap(phys, len);
+	if (!base)
+		return;
+
+	hdr = (struct luna_handoff_header *)base;
+	if (hdr->magic != LUNA_HANDOFF_MAGIC ||
+	    hdr->major != LUNA_HANDOFF_MAJOR ||
+	    hdr->header_size != LUNA_HANDOFF_HEADER_SIZE ||
+	    hdr->total_size != len ||
+	    hdr->records_offset < LUNA_HANDOFF_HEADER_SIZE ||
+	    !luna_range_ok(hdr->records_offset, hdr->records_size, len))
+		goto out;
+
+	luna_handoff_phys = phys;
+	luna_handoff_size = len;
+	luna_handoff_present = true;
+
+	offset = hdr->records_offset;
+	records_end = hdr->records_offset + hdr->records_size;
+	while (offset < records_end) {
+		u64 next;
+		u32 record_size;
+
+		if (records_end - offset < sizeof(*record))
+			goto invalid;
+
+		record = (struct luna_handoff_record *)(base + offset);
+		record_size = record->size;
+		next = offset + sizeof(*record) + record_size;
+
+		if (record_size > records_end - offset - sizeof(*record))
+			goto invalid;
+
+		if (record->type == LUNA_RECORD_LUNA_INIT_IMAGE) {
+			struct luna_init_image_record *init;
+
+			if (record_size != sizeof(*init))
+				goto invalid;
+
+			init = (struct luna_init_image_record *)record->payload;
+			if (!init->address || !init->size)
+				goto invalid;
+
+			luna_init_phys = (phys_addr_t)init->address;
+			luna_init_size = init->size;
+			luna_init_present = true;
+		}
+
+		/* Records are 8-byte aligned in the Luna wire format. */
+		next = ALIGN(next, 8);
+		if (next > records_end || next <= offset)
+			goto invalid;
+		offset = next;
+	}
+
+	if (!luna_init_present)
+		goto invalid;
+
+	pr_info("Luna: boot handoff v%u.%u accepted (%u bytes)\n",
+		hdr->major, hdr->minor, hdr->total_size);
+	pr_info("Luna: luna-init image at 0x%llx (%llu bytes)\n",
+		(unsigned long long)luna_init_phys,
+		(unsigned long long)luna_init_size);
+	goto out;
+
+invalid:
+	luna_handoff_present = false;
+	luna_init_present = false;
+	luna_handoff_phys = 0;
+	luna_handoff_size = 0;
+	luna_init_phys = 0;
+	luna_init_size = 0;
+out:
+	early_memunmap(base, len);
+}
+
+void __init x86_luna_boot_parse(const struct boot_params *params)
+{
+	phys_addr_t phys;
+	struct setup_data *node;
+
+	phys = params->hdr.setup_data;
+	while (phys) {
+		node = early_memremap(phys, sizeof(*node));
+		if (!node)
+			return;
+
+		if (node->type == LUNA_SETUP_DATA_TYPE) {
+			u64 payload_phys = phys + sizeof(*node);
+			u32 payload_len = node->len;
+
+			early_memunmap(node, sizeof(*node));
+			luna_parse_handoff(payload_phys, payload_len);
+			return;
+		}
+
+		phys = node->next;
+		early_memunmap(node, sizeof(*node));
+	}
+}
+
+bool x86_luna_boot_available(void)
+{
+	return luna_handoff_present && luna_init_present;
+}
+
+phys_addr_t x86_luna_init_phys(void)
+{
+	return luna_init_phys;
+}
+
+u64 x86_luna_init_size(void)
+{
+	return luna_init_size;
+}
+
+phys_addr_t x86_luna_handoff_phys(void)
+{
+	return luna_handoff_phys;
+}
+
+u32 x86_luna_handoff_size(void)
+{
+	return luna_handoff_size;
+}
+
diff --git a/include/linux/luna_boot.h b/include/linux/luna_boot.h
new file mode 100644
--- /dev/null
+++ b/include/linux/luna_boot.h
@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_LUNA_BOOT_H
+#define _LINUX_LUNA_BOOT_H
+
+#include <linux/types.h>
+
+struct boot_params;
+
+#ifdef CONFIG_X86_64
+void x86_luna_boot_parse(const struct boot_params *params);
+bool x86_luna_boot_available(void);
+phys_addr_t x86_luna_init_phys(void);
+u64 x86_luna_init_size(void);
+phys_addr_t x86_luna_handoff_phys(void);
+u32 x86_luna_handoff_size(void);
+#else
+static inline void x86_luna_boot_parse(const struct boot_params *params) { }
+static inline bool x86_luna_boot_available(void) { return false; }
+static inline phys_addr_t x86_luna_init_phys(void) { return 0; }
+static inline u64 x86_luna_init_size(void) { return 0; }
+static inline phys_addr_t x86_luna_handoff_phys(void) { return 0; }
+static inline u32 x86_luna_handoff_size(void) { return 0; }
+#endif
+
+#endif /* _LINUX_LUNA_BOOT_H */

diff --git a/arch/x86/kernel/setup.c b/arch/x86/kernel/setup.c
--- a/arch/x86/kernel/setup.c
+++ b/arch/x86/kernel/setup.c
@@ -962,0 +963 @@
+	x86_luna_boot_parse(&boot_params);
