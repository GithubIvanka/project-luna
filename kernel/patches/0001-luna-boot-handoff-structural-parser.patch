@@ -0,0 +1,189 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#![no_std]
+#![allow(unsafe_op_in_unsafe_fn)]
+
+//! Project Luna kernel-side boot handoff parser.
+//!
+//! The early C kernel provides only the ABI entry point. Luna-specific
+//! parsing and validation are implemented in Rust.
+
+use core::ffi::c_void;
+use core::ptr;
+
+use kernel::bindings;
+
+const LUNA_SETUP_DATA_TYPE: u32 = 0x4c55_4e41;
+const LUNA_HANDOFF_MAGIC: u64 = 0x3130_4448_414e_554c;
+const LUNA_HANDOFF_MAJOR: u16 = 1;
+const LUNA_HANDOFF_HEADER_SIZE: usize = 84;
+const LUNA_HANDOFF_MAX_SIZE: usize = 64 * 1024;
+const LUNA_RECORD_LUNA_INIT_IMAGE: u16 = 5;
+const SETUP_DATA_NODE_SIZE: usize = 16;
+const RECORD_HEADER_SIZE: usize = 8;
+const RECORD_ALIGN: usize = 8;
+const LUNA_INIT_IMAGE_RECORD_SIZE: usize = 56;
+
+static mut LUNA_HANDOFF_PHYS: u64 = 0;
+static mut LUNA_HANDOFF_SIZE: u32 = 0;
+static mut LUNA_INIT_PHYS: u64 = 0;
+static mut LUNA_INIT_SIZE: u64 = 0;
+static mut LUNA_HANDOFF_PRESENT: bool = false;
+static mut LUNA_INIT_PRESENT: bool = false;
+
+#[inline]
+unsafe fn read_u16(base: *const u8, offset: usize) -> u16 {
+    u16::from_le(ptr::read_unaligned(base.add(offset).cast()))
+}
+
+#[inline]
+unsafe fn read_u32(base: *const u8, offset: usize) -> u32 {
+    u32::from_le(ptr::read_unaligned(base.add(offset).cast()))
+}
+
+#[inline]
+unsafe fn read_u64(base: *const u8, offset: usize) -> u64 {
+    u64::from_le(ptr::read_unaligned(base.add(offset).cast()))
+}
+
+#[inline]
+fn range_ok(offset: usize, size: usize, total: usize) -> bool {
+    offset <= total && size <= total - offset
+}
+
+#[inline]
+unsafe fn clear_state() {
+    LUNA_HANDOFF_PHYS = 0;
+    LUNA_HANDOFF_SIZE = 0;
+    LUNA_INIT_PHYS = 0;
+    LUNA_INIT_SIZE = 0;
+    LUNA_HANDOFF_PRESENT = false;
+    LUNA_INIT_PRESENT = false;
+}
+
+unsafe fn unmap(base: *mut u8, len: usize) {
+    bindings::early_memunmap(base.cast::<c_void>(), len);
+}
+
+unsafe fn parse_handoff(phys: u64, len_u32: u32) {
+    clear_state();
+
+    let len = len_u32 as usize;
+    if !(LUNA_HANDOFF_HEADER_SIZE..=LUNA_HANDOFF_MAX_SIZE).contains(&len) {
+        return;
+    }
+
+    let base = bindings::early_memremap(phys as bindings::phys_addr_t, len) as *mut u8;
+    if base.is_null() {
+        return;
+    }
+
+    let magic = read_u64(base, 0);
+    let major = read_u16(base, 8);
+    let minor = read_u16(base, 10);
+    let header_size = read_u32(base, 12) as usize;
+    let total_size = read_u32(base, 16) as usize;
+    let records_offset = read_u64(base, 32) as usize;
+    let records_size = read_u64(base, 40) as usize;
+
+    if magic != LUNA_HANDOFF_MAGIC
+        || major != LUNA_HANDOFF_MAJOR
+        || header_size != LUNA_HANDOFF_HEADER_SIZE
+        || total_size != len
+        || records_offset < LUNA_HANDOFF_HEADER_SIZE
+        || records_offset % RECORD_ALIGN != 0
+        || !range_ok(records_offset, records_size, len)
+    {
+        unmap(base, len);
+        return;
+    }
+
+    let records_end = records_offset + records_size;
+    let mut offset = records_offset;
+    let mut init_seen = false;
+
+    while offset < records_end {
+        if records_end - offset < RECORD_HEADER_SIZE {
+            clear_state();
+            unmap(base, len);
+            return;
+        }
+
+        let record_type = read_u16(base, offset);
+        let record_size = read_u32(base, offset + 4) as usize;
+        let payload = offset + RECORD_HEADER_SIZE;
+
+        if !range_ok(payload, record_size, records_end) {
+            clear_state();
+            unmap(base, len);
+            return;
+        }
+
+        if record_type == LUNA_RECORD_LUNA_INIT_IMAGE {
+            if init_seen || record_size != LUNA_INIT_IMAGE_RECORD_SIZE {
+                clear_state();
+                unmap(base, len);
+                return;
+            }
+
+            let address = read_u64(base, payload);
+            let size = read_u64(base, payload + 8);
+            if address == 0 || size == 0 {
+                clear_state();
+                unmap(base, len);
+                return;
+            }
+
+            LUNA_INIT_PHYS = address;
+            LUNA_INIT_SIZE = size;
+            init_seen = true;
+        }
+
+        let next = match payload
+            .checked_add(record_size)
+            .and_then(|value| value.checked_add(RECORD_ALIGN - 1))
+        {
+            Some(value) => value & !(RECORD_ALIGN - 1),
+            None => {
+                clear_state();
+                unmap(base, len);
+                return;
+            }
+        };
+
+        if next > records_end || next <= offset {
+            clear_state();
+            unmap(base, len);
+            return;
+        }
+
+        offset = next;
+    }
+
+    if !init_seen {
+        clear_state();
+        unmap(base, len);
+        return;
+    }
+
+    LUNA_HANDOFF_PHYS = phys;
+    LUNA_HANDOFF_SIZE = len as u32;
+    LUNA_HANDOFF_PRESENT = true;
+    LUNA_INIT_PRESENT = true;
+
+    kernel::pr_info!(
+        "Luna: boot handoff v{}.{} accepted ({} bytes)\n",
+        major,
+        minor,
+        total_size
+    );
+    kernel::pr_info!(
+        "Luna: luna-init image at {:#x} ({} bytes)\n",
+        LUNA_INIT_PHYS,
+        LUNA_INIT_SIZE
+    );
+
+    unmap(base, len);
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn x86_luna_boot_parse(params: *const bindings::boot_params) {
+    if params.is_null() {
+        clear_state();
+        return;
+    }
+
+    let mut phys = (*params).hdr.setup_data;
+
+    for _ in 0..1024 {
+        if phys == 0 {
+            clear_state();
+            return;
+        }
+
+        let node = bindings::early_memremap(
+            phys as bindings::phys_addr_t,
+            SETUP_DATA_NODE_SIZE,
+        ) as *mut u8;
+        if node.is_null() {
+            clear_state();
+            return;
+        }
+
+        let next = read_u64(node, 0);
+        let node_type = read_u32(node, 8);
+        let len = read_u32(node, 12);
+        unmap(node, SETUP_DATA_NODE_SIZE);
+
+        if node_type == LUNA_SETUP_DATA_TYPE {
+            let Some(payload_phys) = phys.checked_add(SETUP_DATA_NODE_SIZE as u64) else {
+                clear_state();
+                return;
+            };
+            parse_handoff(payload_phys, len);
+            return;
+        }
+
+        phys = next;
+    }
+
+    clear_state();
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn x86_luna_boot_available() -> bool {
+    LUNA_HANDOFF_PRESENT && LUNA_INIT_PRESENT
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn x86_luna_init_phys() -> u64 {
+    LUNA_INIT_PHYS
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn x86_luna_init_size() -> u64 {
+    LUNA_INIT_SIZE
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn x86_luna_handoff_phys() -> u64 {
+    LUNA_HANDOFF_PHYS
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn x86_luna_handoff_size() -> u32 {
+    LUNA_HANDOFF_SIZE
+}
+
+diff --git a/include/linux/luna_boot.h b/include/linux/luna_boot.h
+new file mode 100644
+--- /dev/null
++++ b/include/linux/luna_boot.h
+@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_LUNA_BOOT_H
+#define _LINUX_LUNA_BOOT_H
+
+#include <linux/types.h>
+
+struct boot_params;
+
+#ifdef CONFIG_RUST
+void x86_luna_boot_parse(const struct boot_params *params);
+bool x86_luna_boot_available(void);
+phys_addr_t x86_luna_init_phys(void);
+u64 x86_luna_init_size(void);
+phys_addr_t x86_luna_handoff_phys(void);
+u32 x86_luna_handoff_size(void);
+#else
+static inline void x86_luna_boot_parse(const struct boot_params *params) { }
+static inline bool x86_luna_boot_available(void) { return false; }
+static inline phys_addr_t x86_luna_init_phys(void) { return 0; }
+static inline u64 x86_luna_init_size(void) { return 0; }
+static inline phys_addr_t x86_luna_handoff_phys(void) { return 0; }
+static inline u32 x86_luna_handoff_size(void) { return 0; }
+#endif
+
+#endif /* _LINUX_LUNA_BOOT_H */
+
